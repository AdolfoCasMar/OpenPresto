{
  "app-id": "org.openpresto.OpenPresto",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.10",
  "command": "openpresto",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "env": {
      "BASEAPP_REMOVE_WEBENGINE": "1",
      "BASEAPP_DISABLE_NUMPY": "1"
    }
  },
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ],
  "modules": [
    {
      "name": "openpresto",
      "buildsystem": "simple",
      "build-commands": [
        "QT_QPA_PLATFORM=offscreen python3 -m unittest discover -s tests -v",
        "install -d /app/share/openpresto /app/bin",
        "cp -r openpresto /app/share/openpresto/",
        "find /app/share/openpresto -name '*.pyc' -delete",
        "install -Dm755 packaging/openpresto /app/bin/openpresto",
        "install -Dm644 packaging/org.openpresto.OpenPresto.desktop /app/share/applications/org.openpresto.OpenPresto.desktop",
        "install -Dm644 packaging/org.openpresto.OpenPresto.metainfo.xml /app/share/metainfo/org.openpresto.OpenPresto.metainfo.xml",
        "install -Dm644 packaging/org.openpresto.OpenPresto.xml /app/share/mime/packages/org.openpresto.OpenPresto.xml",
        "install -Dm644 openpresto/data/openpresto.svg /app/share/icons/hicolor/scalable/apps/org.openpresto.OpenPresto.svg",
        "install -Dm644 LICENSE /app/share/licenses/openpresto/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "openpresto",
          "dest": "openpresto",
          "skip": [
            "__pycache__"
          ]
        },
        {
          "type": "dir",
          "path": "packaging",
          "dest": "packaging"
        },
        {
          "type": "dir",
          "path": "tests",
          "dest": "tests",
          "skip": [
            "__pycache__"
          ]
        },
        {
          "type": "file",
          "path": "LICENSE"
        },
        {
          "type": "dir",
          "path": "docs",
          "dest": "docs"
        },
        {
          "type": "dir",
          "path": "tools",
          "dest": "tools",
          "skip": ["__pycache__"]
        }
      ]
    }
  ]
}
